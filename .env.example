# Copy this file to .env and fill in real values. Never commit .env.
# .htaccess blocks .env from being opened in a browser.

# WACRM API key (from repeatgrow.com → Settings → API)
Api=
WACRM_BASE_URL=https://repeatgrow.com/api/v1/messages
# Approved WhatsApp template sent after the form is filled ({{1}} = name)
WACRM_TEMPLATE=enquiry_confirmation

# Password for /admin
ADMIN_PASSWORD=

# Hostinger MySQL (hPanel → Databases). Host is localhost when the PHP runs on Hostinger.
DB_HOST=localhost
DB_NAME=u509616587_landingpage
DB_USER=u509616587_landingpage
DB_PASS=
