# Copy this file to .env and fill in real values. Never commit .env.
# .htaccess blocks .env from being opened in a browser.

# WACRM API key (from repeatgrow.com → Settings → API)
Api=
WACRM_BASE_URL=https://repeatgrow.com/api/v1/messages
# Approved WhatsApp template sent after the form is filled ({{1}} = name)
WACRM_TEMPLATE=enquiry_confirmation

# Password for /admin
ADMIN_PASSWORD=

# Hostinger MySQL (hPanel → Databases). Host is localhost when the PHP runs on Hostinger.
DB_HOST=localhost
DB_NAME=u509616587_landingpage
DB_USER=u509616587_landingpage
DB_PASS=

# Meta Conversions API token (Events Manager -> your Pixel -> Settings). Secret: set it only in the server .env.
# If empty, the server-side Meta event is skipped; leads and WhatsApp still work.
META_CAPI_TOKEN=
# Optional: a Test Events code, to see server events in Events Manager while testing
META_TEST_EVENT_CODE=

# Public tag IDs (safe to expose in the page). These are also built-in defaults in api/config.php,
# so they work even if omitted here; a value set here overrides the default.
META_PIXEL_ID=1589496065992075
GOOGLE_ADS_ID=AW-18495072087
GOOGLE_ADS_LEAD_LABEL=qdGWCPL-7Z8dENfOkfNE
GA4_ID=G-H6FKYMRB8X
