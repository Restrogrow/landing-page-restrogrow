# Copy this file to .env (local) or paste these into Vercel → Settings → Environment Variables.
# Never commit real values. .env is git-ignored; this example file is not.

# WACRM API key (from repeatgrow.com → Settings → API)
Api=

# WACRM API base URL (from the API tab)
WACRM_BASE_URL=

# Approved WhatsApp template sent after the form is filled ({{1}} = name)
WACRM_TEMPLATE=enquiry_confirmation

# Password for /admin
ADMIN_PASSWORD=

# Database: added automatically when you connect Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=
