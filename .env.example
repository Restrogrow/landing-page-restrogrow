# Copy this file to .env and fill in real values. Never commit .env.
# .htaccess blocks .env from being opened in a browser.

# WACRM API key (from repeatgrow.com → Settings → API)
Api=
WACRM_BASE_URL=https://repeatgrow.com/api/v1/messages
# Approved WhatsApp template sent after the form is filled ({{1}} = name)
WACRM_TEMPLATE=enquiry_confirmation

# Password for /admin
ADMIN_PASSWORD=

# Hostinger MySQL (hPanel → Databases). Host is localhost when the PHP runs on Hostinger.
DB_HOST=localhost
DB_NAME=u509616587_landingpage
DB_USER=u509616587_landingpage
DB_PASS=

# Meta Pixel + Conversions API (Events Manager -> your Pixel -> Settings)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: a Test Events code, to see server events in Events Manager while testing
META_TEST_EVENT_CODE=

# Google (public IDs, safe to expose in the page). Leave empty to keep that tag off.
# Google Ads: AW-XXXXXXXXX and the conversion label of the "Lead" conversion action
GOOGLE_ADS_ID=
GOOGLE_ADS_LEAD_LABEL=
# GA4 measurement ID: G-XXXXXXX
GA4_ID=
